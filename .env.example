# ============================================================
# StockLens — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ---- Database -----------------------------------------------
# Local PostgreSQL via Docker
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/stocklens
DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/stocklens

# ---- Redis --------------------------------------------------
# Local Redis via Docker
REDIS_URL=redis://localhost:6379/0

# ---- Upstox API ---------------------------------------------
# Get from: https://developer.upstox.com
# Register a developer app and get these credentials
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Redirect URI — must match exactly what you registered in Upstox developer portal
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/auth/upstox/callback
# This is refreshed daily automatically — do not set manually after first setup
UPSTOX_ACCESS_TOKEN=
UPSTOX_REFRESH_TOKEN=

# ---- Google Gemini AI ---------------------------------------
# Get free API key from: https://aistudio.google.com
# Gemini Flash 1.5: 15 requests/min, 1500/day — free forever
GEMINI_API_KEY=

# ---- App Config ---------------------------------------------
APP_ENV=development
APP_NAME=StockLens
API_HOST=0.0.0.0
API_PORT=8000
WS_PORT=8001

# ---- Frontend Config (NEXT_PUBLIC_ = safe to expose in browser) -
# These point to your local backend — intentionally public for local use
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8001
NEXT_PUBLIC_APP_NAME=StockLens

# ---- Logging ------------------------------------------------
LOG_LEVEL=INFO
# Set to true in production — hides stack traces from responses
PRODUCTION_MODE=false

# ---- Scheduler ----------------------------------------------
# Enable/disable background scheduler
SCHEDULER_ENABLED=true
# IST offset from UTC (India Standard Time = UTC+5:30)
TIMEZONE=Asia/Kolkata

# ---- ML Config ----------------------------------------------
# How many clusters for KMeans
ML_N_CLUSTERS=9
# Minimum data completeness to run valuation (0.0–1.0)
ML_MIN_DATA_COMPLETENESS=0.6

# ---- AI Config ----------------------------------------------
# Max output tokens per Gemini call
AI_MAX_OUTPUT_TOKENS=1000
# Cache TTL for AI summaries (seconds) — 4 hours
AI_CACHE_TTL=14400
